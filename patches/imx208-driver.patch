+static int imx208_power_on(struct imx208 *imx208)
+{
+	int ret;
+
+	ret = regulator_enable(imx208->avdd);
+	if (ret)
+		return ret;
+
+	if (imx208->reset_gpio)
+		gpiod_set_value_cansleep(imx208->reset_gpio, 0);
+	usleep_range(5000, 6000);
+
+	ret = clk_prepare_enable(imx208->clk);
+	if (ret) {
+		regulator_disable(imx208->avdd);
+		return ret;
+	}
+	usleep_range(10000, 15000);
+
+	return 0;
+}
+
+static void imx208_power_off(struct imx208 *imx208)
+{
+	clk_disable_unprepare(imx208->clk);
+	if (imx208->reset_gpio)
+		gpiod_set_value_cansleep(imx208->reset_gpio, 1);
+	regulator_disable(imx208->avdd);
+	imx208->power_enabled = false;
+}
+
+static int imx208_pm_suspend(struct device *dev)
+{
+	struct imx208 *imx208 = to_imx208(i2c_get_clientdata(to_i2c_client(dev)));
+
+	imx208_power_off(imx208);
+
+	return 0;
+}
+
+static int imx208_pm_resume(struct device *dev)
+{
+	struct imx208 *imx208 = to_imx208(i2c_get_clientdata(to_i2c_client(dev)));
+
+	return imx208_power_on(imx208);
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(imx208_pm_ops, imx208_pm_suspend,
+				 imx208_pm_resume, NULL);
