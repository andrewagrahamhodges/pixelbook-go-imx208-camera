diff --git a/src/ipa/ipu3/algorithms/awb.cpp b/src/ipa/ipu3/algorithms/awb.cpp
index 55de05d..9955a51 100644
--- a/src/ipa/ipu3/algorithms/awb.cpp
+++ b/src/ipa/ipu3/algorithms/awb.cpp
@@ -418,6 +418,14 @@ void Awb::awbGreyWorld()
 	 * Gain values are unsigned integer value ranging [0, 8) with 13 bit
 	 * fractional part.
 	 */
+	/*
+	 * Pixelbook Go imx208: in mixed indoor light (warm lamps + cool window
+	 * daylight) grey-world AWB over-boosts blue and the image reads pale and
+	 * cool. Apply a fixed warm trim: boost red, reduce blue.
+	 */
+	redGain *= 1.02;
+	blueGain *= 0.92;
+
 	redGain = std::clamp(redGain, 0.0, 65535.0 / 8192);
 	blueGain = std::clamp(blueGain, 0.0, 65535.0 / 8192);
 
